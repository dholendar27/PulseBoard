// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  VIEWER
}

enum Status {
  OPEN
  INVESTIGATING
  RESOLVED
}

model User {
  id         String @id @default(uuid())
  first_name String
  last_name  String
  email      String @unique
  password   String
  role       Role   @default(ADMIN)

  invited_by_id String?
  invitedBy     User?   @relation("UserManager", fields: [invited_by_id], references: [id])
  invitedUsers  User[]  @relation("UserManager")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  createdIncidents  Incident[] @relation("CreatedIncidents")
  assignedIncidents Incident[] @relation("AssignedIncidents")

  @@index([invited_by_id])
}

model Incident {
  id          String  @id @default(uuid())
  title       String
  description String?
  status      Status  @default(OPEN)

  created_by_user_id String
  assigned_to_id     String
  created_by_user    User     @relation("CreatedIncidents", fields: [created_by_user_id], references: [id])
  assigned_to_user   User     @relation("AssignedIncidents", fields: [assigned_to_id], references: [id])
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}
